{
  "name": "startshop/enterprise-ecommerce",
  "description": "StartShop: tienda de videojuegos fisicos y digitales (PHP + MariaDB)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "stripe/stripe-php": "^16.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["includes/"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "serve": "php -S localhost:8000",
    "db:migrate": "mysql -u root startshop < database_extensions.sql",
    "db:seed": "mysql -u root startshop < seed_data.sql",
    "db:setup": ["@db:migrate", "@db:seed"],
    "test": "phpunit --colors=always"
  }
}